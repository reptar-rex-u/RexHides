<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>RexHides</AssemblyTitle>
    <Product>RexHides</Product>
    <Version>0.1.0</Version>
    <Description>Minimize any window to its own dynamic system tray icon.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableGHome>false</EnableGHome>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableGHome)' == 'true'">
    <DefineConstants>$(DefineConstants);GHOME</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableGHome)' != 'true'">
    <Compile Remove="Models\GHomeProfile.cs" />
    <Compile Remove="Services\GHomeService.cs" />
    <Compile Remove="Services\GHomeIdentityMatcher.cs" />
    <Page Remove="Views\GHomeSection.xaml" />
    <Compile Remove="Views\GHomeSection.xaml.cs" />
    <Compile Remove="ViewModels\MainViewModel.GHome.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableGHome)' == 'true'">
    <EmbeddedResource Include="Assets\ghome.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only used for NotifyIcon; drop its implicit global using so WPF types win. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
