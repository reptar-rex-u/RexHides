<UserControl x:Class="RexHides.Views.GHomeSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#E2E2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F1F2E"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="#EEEEF6"/>
            <Setter Property="Foreground" Value="#33334A"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource SectionBorder}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="G Home"/>
            <TextBlock Foreground="#6B6B80" Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="Opt-in persistent tray mode for the Google Home Brave PWA. RexHides matches the Brave process command line for home.google.com, so page titles like Devices still work. Other Brave windows and PWAs stay on the normal temporary tray flow."/>
            <CheckBox Content="Enable G Home persistent tray mode" Margin="0,2"
                      IsChecked="{Binding GHomeEnabled}"/>
            <CheckBox Content="Show G Home title-bar minimize button" Margin="0,2"
                      IsChecked="{Binding GHomeShowOverlayButton}"/>
            <TextBlock Margin="0,8,0,4" Foreground="#33334A"
                       Text="{Binding GHomeIdentitySummary}"/>
            <TextBlock Margin="0,0,0,8" Foreground="#6B6B80"
                       Text="{Binding GHomeConnectionSummary}"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                        Command="{Binding IdentifyGHomeWindowCommand}"
                        Content="Find Google Home"/>
                <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                        Command="{Binding ToggleGHomeCommand}"
                        Content="Toggle Show/Hide"/>
                <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                        Command="{Binding ShowGHomeCommand}"
                        Content="Show"/>
                <Button Style="{StaticResource SubtleButton}"
                        Command="{Binding HideGHomeCommand}"
                        Content="Hide"/>
            </StackPanel>
            <TextBlock Text="{Binding GHomeStatusText}" Foreground="#55556A" Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
