<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: mirrors RexControls web/styles.css ("dark bento"). -->
    <SolidColorBrush x:Key="BentoBgBrush" Color="#10131B"/>
    <SolidColorBrush x:Key="BentoPanelBrush" Color="#171C27"/>
    <SolidColorBrush x:Key="BentoRowBrush" Color="#202735"/>
    <SolidColorBrush x:Key="BentoCardBrush" Color="#E0171C27"/>
    <SolidColorBrush x:Key="BentoInnerBrush" Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="BentoTextBrush" Color="#F2F5FB"/>
    <SolidColorBrush x:Key="BentoMutedBrush" Color="#8994A7"/>
    <SolidColorBrush x:Key="BentoBorderBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="BentoErrorBrush" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="BentoFocusBrush" Color="#5B9DFF"/>

    <RadialGradientBrush x:Key="BentoWindowBackground"
                         Center="0.85,0.05" GradientOrigin="0.85,0.05"
                         RadiusX="0.9" RadiusY="0.7">
        <GradientStop Color="#1D2433" Offset="0"/>
        <GradientStop Color="#10131B" Offset="0.48"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="BlueTileBrush" Color="#85182D4D"/>
    <SolidColorBrush x:Key="BlueTileBorderBrush" Color="#475B9DFF"/>
    <SolidColorBrush x:Key="BlueLabelBrush" Color="#5B9DFF"/>
    <SolidColorBrush x:Key="BlueButtonTextBrush" Color="#C7D9FF"/>
    <SolidColorBrush x:Key="BlueButtonFillBrush" Color="#1F5B9DFF"/>
    <SolidColorBrush x:Key="BlueButtonBorderBrush" Color="#475B9DFF"/>
    <SolidColorBrush x:Key="BlueButtonHoverBrush" Color="#3D5B9DFF"/>

    <SolidColorBrush x:Key="PurpleTileBrush" Color="#7A36214E"/>
    <SolidColorBrush x:Key="PurpleTileBorderBrush" Color="#42A987FF"/>
    <SolidColorBrush x:Key="PurpleLabelBrush" Color="#A987FF"/>
    <SolidColorBrush x:Key="PurpleButtonTextBrush" Color="#E0D2FF"/>
    <SolidColorBrush x:Key="PurpleButtonFillBrush" Color="#21A987FF"/>
    <SolidColorBrush x:Key="PurpleButtonBorderBrush" Color="#4DA987FF"/>
    <SolidColorBrush x:Key="PurpleButtonHoverBrush" Color="#3DA987FF"/>

    <SolidColorBrush x:Key="GreenTileBrush" Color="#7A143E30"/>
    <SolidColorBrush x:Key="GreenTileBorderBrush" Color="#3D55D39A"/>
    <SolidColorBrush x:Key="GreenLabelBrush" Color="#55D39A"/>
    <SolidColorBrush x:Key="GreenButtonTextBrush" Color="#C5F3DF"/>
    <SolidColorBrush x:Key="GreenButtonFillBrush" Color="#1F55D39A"/>
    <SolidColorBrush x:Key="GreenButtonBorderBrush" Color="#4755D39A"/>
    <SolidColorBrush x:Key="GreenButtonHoverBrush" Color="#3D55D39A"/>

    <SolidColorBrush x:Key="AmberTileBrush" Color="#82542A00"/>
    <SolidColorBrush x:Key="AmberTileBorderBrush" Color="#3DF2C477"/>
    <SolidColorBrush x:Key="AmberLabelBrush" Color="#F2C477"/>
    <SolidColorBrush x:Key="AmberButtonTextBrush" Color="#FFE2AE"/>
    <SolidColorBrush x:Key="AmberButtonFillBrush" Color="#2EF2C477"/>
    <SolidColorBrush x:Key="AmberButtonBorderBrush" Color="#7AF2C477"/>
    <SolidColorBrush x:Key="AmberButtonHoverBrush" Color="#47F2C477"/>

    <!-- Cards: the shadow is cast by an opaque sibling layer so card text keeps ClearType. -->
    <Style x:Key="BentoCard" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource BentoCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BentoBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,14,16,16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="20" Background="{StaticResource BentoBgBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270"
                                                  Opacity="0.25" Color="Black" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BlueCard" TargetType="ContentControl" BasedOn="{StaticResource BentoCard}">
        <Setter Property="Background" Value="{StaticResource BlueTileBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BlueTileBorderBrush}"/>
    </Style>
    <Style x:Key="PurpleCard" TargetType="ContentControl" BasedOn="{StaticResource BentoCard}">
        <Setter Property="Background" Value="{StaticResource PurpleTileBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PurpleTileBorderBrush}"/>
    </Style>
    <Style x:Key="GreenCard" TargetType="ContentControl" BasedOn="{StaticResource BentoCard}">
        <Setter Property="Background" Value="{StaticResource GreenTileBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GreenTileBorderBrush}"/>
    </Style>
    <Style x:Key="AmberCard" TargetType="ContentControl" BasedOn="{StaticResource BentoCard}">
        <Setter Property="Background" Value="{StaticResource AmberTileBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AmberTileBorderBrush}"/>
    </Style>

    <Style x:Key="InnerPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BentoInnerBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <!-- Typography -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BentoMutedBrush}"/>
    </Style>
    <Style x:Key="CardLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
        <Setter Property="Margin" Value="2,0,0,4"/>
    </Style>
    <Style x:Key="CardDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource BentoMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="2,0,0,12"/>
    </Style>

    <!-- Buttons (keyed only, so the title-bar overlay button is never affected) -->
    <Style x:Key="BentoButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
        <Setter Property="Background" Value="#0FFFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource BentoBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#99F2F5FB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource BentoButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#21FFFFFF"/>
                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource BentoButton}">
        <Setter Property="Background" Value="{StaticResource BlueButtonFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BlueButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource BlueButtonTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BlueButtonHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PurpleButton" TargetType="Button" BasedOn="{StaticResource BentoButton}">
        <Setter Property="Background" Value="{StaticResource PurpleButtonFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PurpleButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PurpleButtonTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PurpleButtonHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PurpleStrongButton" TargetType="Button" BasedOn="{StaticResource BentoButton}">
        <Setter Property="Background" Value="#3DA987FF"/>
        <Setter Property="BorderBrush" Value="#73A987FF"/>
        <Setter Property="Foreground" Value="#F0E9FF"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#59A987FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource BentoButton}">
        <Setter Property="Background" Value="{StaticResource GreenButtonFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GreenButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GreenButtonTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GreenButtonHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AmberButton" TargetType="Button" BasedOn="{StaticResource BentoButton}">
        <Setter Property="Background" Value="{StaticResource AmberButtonFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AmberButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AmberButtonTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AmberButtonHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Header primary action: warmer orange than the amber card accent. -->
    <Style x:Key="PrimaryOrangeButton" TargetType="Button" BasedOn="{StaticResource BentoButton}">
        <Setter Property="Background" Value="#4DFFA552"/>
        <Setter Property="BorderBrush" Value="#B3FFA552"/>
        <Setter Property="Foreground" Value="#FFDDBA"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#6BFFA552"/>
                <Setter Property="BorderBrush" Value="#E6FFA552"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Neutral button with a little more presence than NeutralButton. -->
    <Style x:Key="HighlightButton" TargetType="Button" BasedOn="{StaticResource BentoButton}">
        <Setter Property="Background" Value="#1CFFFFFF"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2EFFFFFF"/>
                <Setter Property="BorderBrush" Value="#5CFFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Custom title bar buttons (Segoe Fluent Icons on Windows 11, MDL2 Assets on Windows 10). -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource BentoMutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#17FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#0DFFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#D9E5484D"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#A6E5484D"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- CheckBox: rounded box like RexControls .auto-box -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
        <Setter Property="Background" Value="#33000000"/>
        <Setter Property="BorderBrush" Value="#8C8994A7"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="5"
                                VerticalAlignment="Top" Margin="0,1,0,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Path x:Name="Check" Visibility="Collapsed"
                                      Data="M 2.5,6.6 L 5.2,9.2 L 10.4,3.6"
                                      Stroke="#0D1118" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Rectangle x:Name="Dash" Visibility="Collapsed" Width="7" Height="2"
                                           RadiusX="1" RadiusY="1" Fill="#0D1118"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="ContentHost" Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#E6B4BECD"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BentoFocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource GreenLabelBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenLabelBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource GreenLabelBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenLabelBrush}"/>
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource BentoRowBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BentoBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="CaretBrush" Value="{StaticResource BentoTextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BentoFocusBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BentoFocusBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox -->
    <ControlTemplate x:Key="BentoComboToggleTemplate" TargetType="ToggleButton">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="10"
                SnapsToDevicePixels="True"/>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource BentoRowBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BentoBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7,30,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root">
                        <ToggleButton x:Name="Toggle"
                                      Template="{StaticResource BentoComboToggleTemplate}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Path x:Name="Chevron"
                              IsHitTestVisible="False"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,11,0"
                              Data="M 0,0 L 4,4 L 8,0"
                              Stroke="{StaticResource BentoMutedBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Margin="0,4,14,18"
                                    MinWidth="{Binding ActualWidth, ElementName=Root}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource BentoPanelBrush}"
                                    BorderBrush="{StaticResource BentoBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270"
                                                      Opacity="0.35" Color="Black" RenderingBias="Performance"/>
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource BentoTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource BentoTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BentoFocusBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Borderless variant for ComboBoxes that live inside grid cells. -->
    <Style x:Key="InlineComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8,3,26,3"/>
        <Setter Property="Margin" Value="2,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0FFFFFFF"/>
                <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#265B9DFF"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#14FFFFFF"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsHighlighted" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#385B9DFF"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ScrollBar: thin, no arrows -->
    <Style x:Key="BentoScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="4" Background="#2EFFFFFF"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BentoScrollPage" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="BentoVerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource BentoScrollPage}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource BentoScrollPage}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource BentoScrollThumb}" Margin="1,2"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="BentoHorizontalScrollBar" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource BentoScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource BentoScrollPage}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource BentoScrollThumb}" Margin="2,1"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template" Value="{StaticResource BentoVerticalScrollBar}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template" Value="{StaticResource BentoHorizontalScrollBar}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ToolTip -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource BentoPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BentoBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Column-resize gripper shared by ListView and DataGrid headers -->
    <Style x:Key="BentoHeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListView (GridView mode) -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource BentoMutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="6,4,6,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border Background="Transparent"
                                BorderBrush="{StaticResource BentoBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" Style="{StaticResource BentoHeaderGripper}"
                               HorizontalAlignment="Right" Margin="0,0,-4,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="Floating">
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0,6"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0BFFFFFF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#145B9DFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid parts -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource BentoMutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="8,4,8,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BentoBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter RecognizesAccessKey="True"/>
                                <Path x:Name="SortArrow" Visibility="Collapsed"
                                      Margin="6,0,0,0" VerticalAlignment="Center"
                                      Stroke="{StaticResource BentoMutedBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </StackPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource BentoHeaderGripper}"
                               HorizontalAlignment="Left" Margin="-4,0,0,0"/>
                        <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource BentoHeaderGripper}"
                               HorizontalAlignment="Right" Margin="0,0,-4,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0,4 L 3.5,0.5 L 7,4"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0,0.5 L 3.5,4 L 7,0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="DGR_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="0,2"
                            SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </SelectiveScrollingGrid.RowDefinitions>
                            <DataGridCellsPresenter Grid.Column="1"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1"
                                                      SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                      Visibility="{TemplateBinding DetailsVisibility}"/>
                            <DataGridRowHeader Grid.RowSpan="2"
                                               SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                               Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                        </SelectiveScrollingGrid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DGR_Border" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="DGR_Border" Property="Background" Value="#1FA987FF"/>
                            <Setter TargetName="DGR_Border" Property="BorderBrush" Value="#33A987FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource BentoTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Element/editing styles for DataGrid columns (column defaults bypass implicit styles). -->
    <Style x:Key="GridCheckBoxElement" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="GridCheckBoxEditing" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GridTextElement" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="GridTextEditing" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="2,0"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource PurpleLabelBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
